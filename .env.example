# =============================================
# Wake-on-LAN Alexa Skill — Environment Variables
# Copy to .env and fill in real values.
# =============================================

# --- AWS (used by src/index.js) ---
# Optional: AWS region (defaults to eu-west-1)
AWS_REGION=eu-west-1

# Optional: DynamoDB table used to store Alexa Event Gateway tokens
DYNAMODB_TABLE_NAME=TableNameForAlexaEventGatewayTokens

# --- Alexa Event Gateway (Alexa.WakeOnLANController) ---
# Required: generated under Alexa Developer Console -> Permissions -> "Send Alexa Events"
ALEXA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALEXA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Alexa Event Gateway endpoint (defaults to EU: https://api.eu.amazonalexa.com/v3/events)
# North America: https://api.amazonalexa.com/v3/events
# Europe/India: https://api.eu.amazonalexa.com/v3/events
# Far East: https://api.fe.amazonalexa.com/v3/events
ALEXA_EVENT_GATEWAY_URL=https://api.eu.amazonalexa.com/v3/events

# --- Devices (Option A, recommended): multi-device JSON array ---
# Required if MAC_ADDRESS is not set. Keep this JSON on one line in Lambda env vars.
# deviceId must match the PC script's -DeviceId / DEVICE_ID and PC_SECRETS keys.
WOL_DEVICES=[{"endpointId":"office-pc","friendlyName":"Office PC","macAddress":"AA:BB:CC:DD:EE:FF"},{"endpointId":"gaming-rig","friendlyName":"Gaming Rig","macAddress":"11:22:33:44:55:66"}]

# --- Devices (Option B, backward-compatible): single device ---
# Required if WOL_DEVICES is not set
MAC_ADDRESS=AA:BB:CC:DD:EE:FF
# Optional: endpointId (defaults to wol-pc-001)
ENDPOINT_ID=wol-pc-001
# Optional: friendlyName (defaults to PC)
PC_FRIENDLY_NAME=My PC

# --- Shutdown via wol-bridge (TurnOff) ---
# The bridge is a separate Lambda with a public Function URL; the PC polls it and
# the Alexa Lambda writes shutdown commands to DynamoDB. Env vars below are for
# the bridge unless noted. The PC script itself takes the grace period as an
# argument (see scripts/README.md).
# Required on the bridge: per-device shared secrets map, e.g.
PC_SECRETS={"wol-pc-001":"REPLACE_WITH_RANDOM_SECRET"}
# Optional on the bridge: skill Lambda name invoked for ChangeReports / warmup
WOL_SKILL_FUNCTION=alexa-wake-on-lan
# Optional (skill Lambda): how old a heartbeat is considered offline (default 11 min)
DEVICE_STALE_MS=660000
